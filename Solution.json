{
    "schemaVersion": "0.1",
    "solution": {
        "name": "MinimalSolution",
        "version": "0.3.0"
    },
    "settings": {
        "standards": {
            "cxx_standard": 20
        },
        "defaults": {
            "library_type": "INTERFACE",
            "executable_type": "CONSOLE"
        },
        "sources": {
            "mode": "auto"
        }
    },
    "externals": {
        "bass": {
            "path": "externals/bass"
        }
    },
    "libraries": [
        {
            "name": "BasicLogger",
            "version": "1.0.0",
            "type": "INTERFACE",
            "public_headers": "projects/libs/BasicLogger/include"
        }
    ],
  "executables": [
    {
      "name": "MinimalConsole",
      "version": "2.0.0",
      "dependencies": [ "BasicLogger" ],
      "externals": [ "bass" ],
      "external_options": {
        "bass": {
          "BASS_FLAC": true
        }
      }
    },
    {
      "name": "consolePlayer",
      "version": "1.0.0",
      "dependencies": [ "BasicLogger" ],
      "externals": [ "bass" ],
      "external_options": {
        "bass": {
          "BASS_FLAC": true,
          "BASS_FX": true
        }
      }
    },
    {
      "name": "MinimalWindow",
      "version": "0.1.0",
      "type": "GUI",
      "path": "projects/exec/MinimalWindow/src",
      "skip": false,
      "dependencies": [ "BasicLogger" ]
    }
  ]
}
