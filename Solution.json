{
    "schemaVersion": "0.6",
    "solution": {
        "name": "MinimalSolution",
        "version": "0.5.0"
    },
    "settings": {
        "standards": {
            "cxx_standard": 20
        },
        "defaults": {
            "library_type": "INTERFACE",
            "executable_type": "CONSOLE"
        },
        "sources": {
            "mode": "auto"
        }
    },
  "externals": {
    "bass": {
      "path": "externals/bass"
    },
    "lua54": {
      "path": "externals/lua54"
    },
    "doctest": {
      "path": "externals/doctest"
    },
    "glad": {
      "path": "externals/glad"
    },
    "glfw": {
      "git": "https://github.com/glfw/glfw.git",
      "tag": "3.4"
    },
    "imgui": {
      "git": "https://github.com/ocornut/imgui.git",
      "tag": "v1.91.6",
      "cmakeSupport": false
    },
    "imgui_docking": {
      "git": "https://github.com/ocornut/imgui.git",
      "tag": "v1.91.6-docking",
      "cmakeSupport": false,
      "hook": "imgui"
    },
    "googletest": {
      "git": "https://github.com/google/googletest.git",
      "tag": "v1.14.0"
    },
    "catch2": {
      "git": "https://github.com/catchorg/Catch2.git",
      "tag": "v3.5.2"
    },
    "qt6": {
      "path": "externals/qt6",
      "options": {
        "components": [ "Core", "Widgets", "Gui", "OpenGL" ],
        "hint": "${QT_ROOT}",
        "backup": "E:/Backup/Qt/6.7.0/msvc2022_64"
      }
    }
  },
    "libraries": [
        {
            "name": "BasicLogger",
            "version": "1.0.0",
            "type": "INTERFACE",
            "public_headers": "projects/demos/libs/BasicLogger/include"
        }
    ],
    "executables": [
      {
        "name": "MinimalConsole",
        "displayName": "Console_Demo_Minimal",
        "version": "2.0.0",
        "path": "projects/demos/exec/MinimalConsole/src",
        "skip": false,
        "dependencies": [ "BasicLogger" ],
        "externals": [ "bass" ],
        "external_options": {
          "bass": {
            "BASS_FLAC": true
          }
        }
      },
      {
        "name": "consolePlayer",
        "displayName": "Console_Demo_Player",
        "version": "1.0.0",
        "path": "projects/demos/exec/consolePlayer/src",
        "skip": true,
        "dependencies": [ "BasicLogger" ],
        "externals": [ "bass" ],
        "external_options": {
          "bass": {
            "BASS_FLAC": true,
            "BASS_FX": true
          }
        }
      },
        {
            "name": "MinimalWindow",
            "displayName": "Window_Demo_Minimal",
            "version": "0.1.0",
            "type": "GUI",
            "path": "projects/demos/exec/MinimalWindow/src",
            "skip": true,
            "dependencies": ["BasicLogger"]
        },
      {
        "name": "imGuiApp",
        "displayName": "imGui_Demo",
        "version": "0.1.0",
        "type": "GUI",
        "path": "projects/demos/exec/imGuiApp/src",
        "skip": true,
        "dependencies": [ "BasicLogger" ],
        "externals": [ "glad", "glfw", "imgui_docking" ]
      },
      {
        "name": "QtMarkdownViewer",
        "displayName": "MarkdownViewer",
        "version": "0.1.0",
        "type": "GUI",
        "path": "projects/demos/exec/QtMarkdownViewer/src",
        "skip": true,
        "dependencies": [],
        "externals": [ "qt6" ]
      }
    ],
    "apps": [
      {
        "name": "MyVisualizer",
        "displayName": "MyVizualizer",
        "version": "0.1.0",
        "description": "Audio Visualizer",
        "pch": {
          "enabled": true
        },
        "core": {
          "dependencies": [],
          "externals": []
        },

        "runner": {
          "type": "GUI",
          "externals": []
        },

        "tests": {
          "framework": "doctest",
          "targets": [
            {
              "name": "UnitTests",
              "type": "unit",
              "path": "tests/unit/UnitTests",
              "timeout": 30,
              "labels": [ "unit", "demo", "fast" ]
            },
            {
              "name": "IntegrationTests",
              "type": "integration",
              "path": "tests/integration/IntegrationTests",
              "timeout": 120,
              "labels": [ "integration", "demo", "slow" ]
            },
            {
              "name": "PerformanceTests",
              "skip": true,
              "type": "performance",
              "path": "tests/performance/PerformanceTests",
              "timeout": 300,
              "labels": [ "performance", "demo", "benchmark" ]
            }
          ]
        },

        "platforms": [ "windows", "linux", "macos" ]
      },
      {
        "name": "DemoPlayer",
        "skip": false,
        "displayName": "Demo Player Application",
        "version": "0.5.0",
        "description": "Phase 8 App-Container Demo",

        "core": {
          "dependencies": [],
          "externals": []
        },

        "runner": {
          "type": "CONSOLE",
          "externals": []
        },

        "tests": {
          "framework": "doctest",
          "skip": true,
          "targets": [
            {
              "name": "UnitTests",
              "type": "unit",
              "path": "tests/unit/UnitTests",
              "timeout": 30,
              "labels": [ "unit", "demo", "fast" ]
            }
          ]
        },

        "platforms": [ "windows", "linux", "macos" ]
      }
    ],
    "tests": [
      {
        "name": "BasicLogger_UnitTests",
        "displayName": "BasicLogger Unit Tests (doctest)",
        "type": "unit",
        "framework": "doctest",
        "path": "projects/tests/unit/BasicLogger_Tests/src",
        "skip": false,
        "dependencies": [ "BasicLogger" ],
        "externals": [ "doctest" ],
        "labels": [ "unit", "logger", "fast" ],
        "timeout": 30
      },
      {
        "name": "StringUtils_UnitTests",
        "displayName": "StringUtils Unit Tests (GoogleTest)",
        "type": "unit",
        "framework": "googletest",
        "path": "projects/tests/unit/StringUtils_Tests/src",
        "skip": true,
        "externals": [ "googletest" ],
        "labels": [ "unit", "utils", "fast" ],
        "timeout": 30
      },
      {
        "name": "MathUtils_UnitTests",
        "displayName": "MathUtils Unit Tests (Catch2)",
        "type": "unit",
        "framework": "catch2",
        "path": "projects/tests/unit/MathUtils_Tests/src",
        "skip": true,
        "externals": [ "catch2" ],
        "labels": [ "unit", "math", "fast" ],
        "timeout": 30
      },
      {
        "name": "AudioPipeline_IntegrationTests",
        "displayName": "Audio Pipeline Integration (doctest)",
        "type": "integration",
        "framework": "doctest",
        "path": "projects/tests/integration/AudioPipeline_Tests/src",
        "skip": true,
        "dependencies": [ "BasicLogger" ],
        "externals": [ "doctest", "bass" ],
        "external_options": {
          "bass": { "BASS_FLAC": true }
        },
        "labels": [ "integration", "audio", "slow" ],
        "timeout": 120,
        "parallel": false
      },
      {
        "name": "System_EndToEndTests",
        "displayName": "System E2E Tests (GoogleTest)",
        "type": "system",
        "framework": "googletest",
        "path": "projects/tests/system/E2E_Tests/src",
        "skip": true,
        "dependencies": [ "BasicLogger" ],
        "externals": [ "googletest" ],
        "labels": [ "system", "e2e", "slow" ],
        "timeout": 180,
        "parallel": false
      },
      {
        "name": "Performance_Benchmarks",
        "displayName": "Performance Benchmarks (Catch2)",
        "type": "performance",
        "framework": "catch2",
        "path": "projects/tests/performance/Benchmarks/src",
        "skip": true,
        "externals": [ "catch2" ],
        "labels": [ "performance", "benchmark", "slow" ],
        "timeout": 300,
        "parallel": false
      },
      {
        "name": "Smoke_Tests",
        "displayName": "Smoke Tests (doctest)",
        "type": "smoke",
        "framework": "doctest",
        "path": "projects/tests/smoke/Smoke_Tests/src",
        "skip": true,
        "dependencies": [ "BasicLogger" ],
        "externals": [ "doctest" ],
        "labels": [ "smoke", "critical", "fast" ],
        "timeout": 10
      }
    ]
}
