{
    "schemaVersion": "0.1",
    
    "solution": {
        "name": "MinimalSolution",
        "version": "0.2.0",
        "description": "Minimal solution demonstrating Library Pipeline",
        "authors": ["Build System Team"]
    },
    
    "settings": {
        "standards": {
            "cxx_standard": 20,
            "cxx_standard_required": true,
            "cxx_extensions": false
        },
        "defaults": {
            "library_type": "INTERFACE",
            "executable_type": "CONSOLE"
        },
        "sources": {
            "mode": "auto"
        }
    },
    
    "externals": {},
    
    "libraries": [
        {
            "name": "BasicLogger",
            "version": "1.0.0",
            "type": "INTERFACE",
            "public_headers": "projects/libs/BasicLogger/include"
        }
    ],
    
    "executables": [
        {
            "name": "MinimalConsole",
            "version": "1.1.0",
            "type": "CONSOLE",
            "path": "projects/exec/MinimalConsole/src",
            "dependencies": ["BasicLogger"]
        }
    ],
    
    "tests": []
}
