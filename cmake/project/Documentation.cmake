# cmake/project/Documentation.cmake
# ==================================
# Documentation target - runs Doxygen with the project's own Doxyfile
#
# Version: 1.0.0
# Date:    2026-11-26
# Status:  Release
# Author:  CMake Architecture Team
#
# Dependencies:
#   - cmake/core/Errors.cmake
#   - cmake/core/Debug.cmake
#   - cmake/core/Json.cmake
#   - cmake/project/Solution.cmake (SOLUTION_JSON)
#
# Provides:
#   - _create_doxygen_target(DOXYGEN_JSON)
#   - Target <target> (default "docs", not part of ALL) when Solution.json has
#     the block "documentation": { "doxygen": { "doxyfile": "<path>" } }
#
# Behaviour:
#   - The Doxyfile belongs to the project and is passed unchanged; Doxygen
#     runs in the project root (CMAKE_SOURCE_DIR), so its relative paths
#     resolve exactly as with "doxygen <doxyfile>" from the root.
#   - Doxygen's exit code is passed through: WARN_AS_ERROR = YES (or
#     FAIL_ON_WARNINGS) in the Doxyfile makes the target fail.
#   - Doxygen not found: W202 at configure time; the target still exists and
#     fails at build time with a message.
#   - No block: nothing is searched, nothing is created.
#   - A configuration generated by CMakeCraft (Future_Enhancements.md 8.3) is
#     not supported; "doxyfile" is required (E001).
#
# Used by:
#   - CMakeCraft.cmake

include_guard(GLOBAL)

dbg_init(ID DOCUMENTATION LEVEL ${DBG_SHOW_MUCH} SWITCH ON TAG "Documentation")

# ============================================================================
# _create_doxygen_target - Creates the documentation target
# ============================================================================
#[[
    _create_doxygen_target(DOXYGEN_JSON)

    Parameters:
        DOXYGEN_JSON - Mandatory: JSON string of "documentation.doxygen"

    JSON fields:
        doxyfile - Mandatory: path of the Doxyfile relative to the project
                   root
        target   - Optional: name of the target (default: "docs")
]]
function(_create_doxygen_target DOXYGEN_JSON)

    _json_get_string("${DOXYGEN_JSON}" "doxyfile" _doxyfile)
    if("${_doxyfile}" STREQUAL "")
        cmake_fatal("E001" "documentation.doxygen: required field 'doxyfile' missing or empty "
            "(path of the project's Doxyfile relative to the project root; a generated configuration is not supported)")
    endif()

    _json_get_string_or_default("${DOXYGEN_JSON}" "target" "docs" _target)

    if(TARGET ${_target})
        cmake_fatal("E102" "documentation.doxygen: target '${_target}' already exists - choose another name with 'target'")
    endif()

    if(IS_ABSOLUTE "${_doxyfile}")
        set(_doxyfile_abs "${_doxyfile}")
    else()
        set(_doxyfile_abs "${CMAKE_SOURCE_DIR}/${_doxyfile}")
    endif()
    if(NOT EXISTS "${_doxyfile_abs}" OR IS_DIRECTORY "${_doxyfile_abs}")
        cmake_fatal("E107" "documentation.doxygen: Doxyfile not found: ${_doxyfile_abs}")
    endif()

    find_package(Doxygen QUIET)

    if(TARGET Doxygen::doxygen)
        add_custom_target(${_target}
            COMMAND Doxygen::doxygen "${_doxyfile}"
            WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}"
            COMMENT "Doxygen ${DOXYGEN_VERSION}: ${_doxyfile}"
            VERBATIM
            USES_TERMINAL)
        dbg(${DBG_OFTEN} "Target '${_target}': Doxygen ${DOXYGEN_VERSION} (${DOXYGEN_EXECUTABLE}), ${_doxyfile}" ID DOCUMENTATION)
    else()
        cmake_warn("W202" "documentation.doxygen: Doxygen not found - target '${_target}' fails when built. "
            "Install Doxygen or set DOXYGEN_EXECUTABLE, then configure again.")
        add_custom_target(${_target}
            COMMAND "${CMAKE_COMMAND}" -E echo "Doxygen not found - target '${_target}' cannot run ${_doxyfile}. Install Doxygen and configure again."
            COMMAND "${CMAKE_COMMAND}" -E false
            WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}"
            VERBATIM)
    endif()

    set_target_properties(${_target} PROPERTIES
        FOLDER "Documentation"
        CRAFT_DOXYFILE "${_doxyfile}")

endfunction()

# ============================================================================
# Pipeline
# ============================================================================

get_property(_doc_solution_json GLOBAL PROPERTY SOLUTION_JSON)
_json_get_type("${_doc_solution_json}" "documentation" _doc_type)

if(NOT "${_doc_type}" STREQUAL "")
    if(NOT "${_doc_type}" STREQUAL "OBJECT")
        cmake_fatal("E001" "Solution.json: 'documentation' must be an object")
    endif()
    _json_get_object("${_doc_solution_json}" "documentation" _doc_obj)
    _json_get_type("${_doc_obj}" "doxygen" _doc_doxygen_type)
    if("${_doc_doxygen_type}" STREQUAL "OBJECT")
        _json_get_object("${_doc_obj}" "doxygen" _doc_doxygen)
        _create_doxygen_target("${_doc_doxygen}")
    elseif(NOT "${_doc_doxygen_type}" STREQUAL "")
        cmake_fatal("E001" "Solution.json: 'documentation.doxygen' must be an object")
    endif()
endif()

enddbgblock(ID DOCUMENTATION)

unset(_doc_solution_json)
unset(_doc_type)
unset(_doc_obj)
unset(_doc_doxygen_type)
unset(_doc_doxygen)
